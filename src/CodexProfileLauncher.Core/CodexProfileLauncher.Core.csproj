<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\keysmith\gpt-unrestricted.md"
                      LogicalName="CodexProfileLauncher.Core.Assets.keysmith.gpt-unrestricted.md" />
    <EmbeddedResource Include="Assets\default-system-prompt\default-system-prompt.md"
                      LogicalName="CodexProfileLauncher.Core.Assets.default-system-prompt.default-system-prompt.md" />
    <Content Include="Assets\keysmith\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="Assets\keysmith\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="Assets\default-system-prompt\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="Assets\default-system-prompt\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
