<Window x:Class="CodexProfileLauncher.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:panels="clr-namespace:CodexProfileLauncher.Views.Panels"
        mc:Ignorable="d"
        Title="Codex 环境管理器"
        Icon="{StaticResource App.VectorIcon}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Brush.Window}"
        Foreground="{DynamicResource App.Brush.TextPrimary}"
        FontFamily="{StaticResource App.Font.Ui}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        AutomationProperties.AutomationId="MainWindow"
        AutomationProperties.Name="Codex 环境管理器">
    <Grid TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact app header: global diagnostics stay secondary to launch. -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource App.IconWell}"
                            Margin="0,0,11,0">
                        <TextBlock Text="&#xE8F1;"
                                   FontFamily="{StaticResource App.Font.Icon}"
                                   FontSize="16"
                                   Foreground="{DynamicResource App.Brush.Accent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Codex 环境管理器"
                                   Style="{StaticResource App.Text.PageTitle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCodexCommand}"
                            Style="{StaticResource App.IconButton}"
                            Content="&#xE72C;"
                            ToolTip="刷新 Codex 检测"
                            AutomationProperties.AutomationId="RefreshCodexButton"
                            AutomationProperties.Name="刷新 Codex 检测" />
                    <Button Command="{Binding OpenLogsCommand}"
                            Style="{StaticResource App.IconButton}"
                            Content="&#xF000;"
                            ToolTip="打开日志"
                            Margin="2,0,0,0"
                            AutomationProperties.AutomationId="OpenLogsButton"
                            AutomationProperties.Name="打开日志" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Environment rail. It deliberately contains no dashboard navigation. -->
            <Border Grid.Column="0" Style="{StaticResource App.Sidebar}">
                <Grid Margin="14,16,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="环境"
                                   Style="{StaticResource App.Text.SectionTitle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding CreateProfileCommand}"
                                Style="{StaticResource App.SecondaryButton}"
                                Padding="11,6"
                                MinHeight="32"
                                AutomationProperties.AutomationId="CreateProfileButton"
                                AutomationProperties.Name="新建环境">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;"
                                           FontFamily="{StaticResource App.Font.Icon}"
                                           FontSize="13"
                                           Foreground="{DynamicResource App.Brush.Accent}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="新建"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             IsEnabled="{Binding IsNotBusy}"
                             Style="{StaticResource App.ProfileListBox}"
                             ItemContainerStyle="{StaticResource App.ProfileListItem}"
                             AutomationProperties.AutomationId="ProfileList"
                             AutomationProperties.Name="环境列表">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑 / 迁移…"
                                          Command="{Binding PlacementTarget.DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="复制环境"
                                          Command="{Binding PlacementTarget.DataContext.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="删除环境及数据"
                                          Command="{Binding PlacementTarget.DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="打开数据目录"
                                          Command="{Binding PlacementTarget.DataContext.OpenDataRootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="0"
                                      AutomationProperties.Name="{Binding Name}"
                                      AutomationProperties.HelpText="{Binding DisplayStatus}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="7"
                                            Background="{DynamicResource App.Brush.AccentSoft}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusGlyph}"
                                                   FontFamily="{StaticResource App.Font.Icon}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource App.Brush.Accent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <Grid Grid.Column="1" Margin="9,0,2,0" MinWidth="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource App.Text.BodyStrong}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding DisplayStatus}"
                                                   Style="{StaticResource App.Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- The main stage holds mutually exclusive empty, unselected, and selected states. -->
            <Grid Grid.Column="1" Background="{DynamicResource App.Brush.Window}">
                <Border Margin="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        Padding="28,32"
                        Background="{DynamicResource App.Brush.Surface}"
                        BorderBrush="{DynamicResource App.Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        AutomationProperties.AutomationId="EmptyStatePanel">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52"
                                Height="52"
                                CornerRadius="12"
                                Background="{DynamicResource App.Brush.AccentSoft}"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,18">
                            <TextBlock Text="&#xE8F1;"
                                       FontFamily="{StaticResource App.Font.Icon}"
                                       FontSize="22"
                                       Foreground="{DynamicResource App.Brush.Accent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="创建第一个环境"
                                   Style="{StaticResource App.Text.ProfileTitle}"
                                   FontSize="20"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="当前还没有环境。创建后即可启动独立的 Codex。"
                                   Style="{StaticResource App.Text.Secondary}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,20" />
                        <Button Command="{Binding CreateProfileCommand}"
                                Content="新建环境"
                                Style="{StaticResource App.PrimaryButton}"
                                HorizontalAlignment="Center"
                                MinWidth="140"
                                AutomationProperties.AutomationId="EmptyCreateProfileButton"
                                AutomationProperties.Name="新建第一个环境" />
                    </StackPanel>
                </Border>

                <Border Margin="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="400"
                        Padding="28,30"
                        Background="{DynamicResource App.Brush.Surface}"
                        BorderBrush="{DynamicResource App.Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        AutomationProperties.AutomationId="NoSelectionPanel">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSelection}" Value="False" />
                                        <Condition Binding="{Binding IsEmpty}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="选择一个环境"
                                   Style="{StaticResource App.Text.ProfileTitle}"
                                   FontSize="20"
                                   TextAlignment="Center" />
                        <TextBlock Text="从左侧选择环境以查看状态并启动 Codex。"
                                   Style="{StaticResource App.Text.Secondary}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="ProfileDetailScrollViewer">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <Grid Margin="28,24,28,32"
                          MaxWidth="960"
                          HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Selected profile identity. -->
                        <Grid Grid.Row="0" MinWidth="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" MinWidth="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{Binding SelectedProfile.Name}"
                                           ToolTip="{Binding SelectedProfile.Name}"
                                           Style="{StaticResource App.Text.ProfileTitle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="SelectedProfileName" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding SelectedProfile.DataRoot}"
                                           ToolTip="{Binding SelectedProfile.DataRoot}"
                                           Style="{StaticResource App.Text.Path}"
                                           Margin="0,4,16,0"
                                           AutomationProperties.AutomationId="SelectedProfileDataRoot" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Command="{Binding EditProfileCommand}"
                                    Content="编辑环境"
                                    Style="{StaticResource App.SecondaryButton}"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="EditProfileButton"
                                    AutomationProperties.Name="编辑当前环境" />
                        </Grid>

                        <!-- One stateful launch panel and one independent action column. -->
                        <Border Grid.Row="1"
                                Style="{StaticResource App.PrimaryPanel}"
                                Margin="0,24,0,0"
                                AutomationProperties.AutomationId="LaunchPanel">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0"
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="10"
                                        Background="{DynamicResource App.Brush.AccentSoft}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusGlyph}"
                                               FontFamily="{StaticResource App.Font.Icon}"
                                               FontSize="16"
                                               Foreground="{DynamicResource App.Brush.Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,24,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusTitle}"
                                               Style="{StaticResource App.Text.StatusTitle}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="StatusText"
                                               AutomationProperties.Name="{Binding StatusTitle}"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Style="{StaticResource App.Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               AutomationProperties.AutomationId="StatusMessageText"
                                               AutomationProperties.Name="{Binding StatusMessage}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="2"
                                            Width="200"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding PrimaryActionCommand}"
                                            IsEnabled="{Binding CanPrimaryAction}"
                                            Content="{Binding PrimaryActionText}"
                                            Style="{StaticResource App.PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.AutomationId="{Binding PrimaryActionAutomationId}"
                                            AutomationProperties.Name="{Binding PrimaryActionText}" />
                                    <Button Command="{Binding CloseCodexCommand}"
                                            Content="关闭 Codex"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.AutomationId="CloseCodexButton"
                                            AutomationProperties.Name="关闭当前环境的 Codex">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource App.SecondaryButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedProfile.IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <ProgressBar Grid.Row="1"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="3"
                                             IsIndeterminate="True"
                                             Height="3"
                                             Margin="0,18,0,0"
                                             AutomationProperties.AutomationId="LaunchProgress"
                                             AutomationProperties.Name="Codex 启动进度">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar"
                                               BasedOn="{StaticResource {x:Type ProgressBar}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Grid>
                        </Border>

                        <!-- Environment config tabs: frequent AI/skills elevated for quick setup. -->
                        <Border Grid.Row="2"
                                Style="{StaticResource App.Card}"
                                Margin="0,20,0,0"
                                Padding="0"
                                AutomationProperties.AutomationId="EnvironmentConfigHost">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0"
                                         SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                         Style="{StaticResource App.EnvironmentTabList}"
                                         AutomationProperties.AutomationId="EnvironmentTabList"
                                         AutomationProperties.Name="环境配置分类">
                                    <ListBoxItem Content="概览" />
                                    <ListBoxItem Content="AI" />
                                    <ListBoxItem Content="技能" />
                                    <ListBoxItem Content="路径" />
                                    <ListBoxItem Content="高级" />
                                    <ListBoxItem Content="管理" />
                                </ListBox>

                                <Grid Grid.Row="1" Margin="18,8,18,16" MinHeight="280">
                                    <!-- Overview -->
                                    <StackPanel AutomationProperties.AutomationId="OverviewTabPanel">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverviewTab}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="环境概览"
                                                   Style="{StaticResource App.Text.SectionTitle}"
                                                   Margin="0,0,0,12" />
                                        <Border Style="{StaticResource App.SectionRow}">
                                            <Grid MinWidth="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="142" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="AI 配置"
                                                           Style="{StaticResource App.Text.BodyStrong}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding AiSettingsSummary}"
                                                           ToolTip="{Binding AiSettingsSummary}"
                                                           Style="{StaticResource App.Text.Caption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Command="{Binding GoToAiTabCommand}"
                                                        Content="打开 AI"
                                                        Style="{StaticResource App.TertiaryButton}"
                                                        AutomationProperties.AutomationId="GoToAiFromOverviewButton" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource App.SectionRow}">
                                            <Grid MinWidth="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="142" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="技能"
                                                           Style="{StaticResource App.Text.BodyStrong}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SkillsSummary}"
                                                           ToolTip="{Binding SkillsSummary}"
                                                           Style="{StaticResource App.Text.Caption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Command="{Binding GoToSkillsTabCommand}"
                                                        Content="管理技能"
                                                        Style="{StaticResource App.TertiaryButton}"
                                                        AutomationProperties.AutomationId="GoToSkillsFromOverviewButton" />
                                            </Grid>
                                        </Border>
                                        <Border Padding="0,14,0,0">
                                            <Grid MinWidth="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="142" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="默认工作目录"
                                                           Style="{StaticResource App.Text.BodyStrong}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SelectedProfile.WorkingDirectory, TargetNullValue=未设置, FallbackValue=未设置}"
                                                           Style="{StaticResource App.Text.Path}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- AI -->
                                    <Grid AutomationProperties.AutomationId="AiTabPanel">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAiTab}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <panels:AiSettingsPanel x:Name="EmbeddedAiSettingsPanel"
                                                                DataContext="{Binding AiSettingsEditor}" />
                                    </Grid>

                                    <!-- Skills -->
                                    <Grid AutomationProperties.AutomationId="SkillsTabPanel">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSkillsTab}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <panels:SkillsPanel DataContext="{Binding}" />
                                    </Grid>

                                    <!-- Paths -->
                                    <StackPanel AutomationProperties.AutomationId="PathsTabPanel">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPathsTab}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="路径与 Codex 应用"
                                                   Style="{StaticResource App.Text.SectionTitle}"
                                                   Margin="0,0,0,12" />
                                        <Border Style="{StaticResource App.SectionRow}">
                                            <Grid MinWidth="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="142" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="环境数据目录"
                                                           Style="{StaticResource App.Text.BodyStrong}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SelectedProfile.DataRoot}"
                                                           ToolTip="{Binding SelectedProfile.DataRoot}"
                                                           Style="{StaticResource App.Text.Path}"
                                                           Margin="0,0,12,0"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Command="{Binding OpenDataRootCommand}"
                                                        Content="打开"
                                                        Style="{StaticResource App.TertiaryButton}"
                                                        AutomationProperties.AutomationId="OpenDataRootButton"
                                                        AutomationProperties.Name="打开环境数据目录" />
                                                <Button Grid.Column="3"
                                                        Command="{Binding CopyDataRootCommand}"
                                                        Content="复制"
                                                        Style="{StaticResource App.TertiaryButton}"
                                                        Margin="4,0,0,0"
                                                        AutomationProperties.AutomationId="CopyDataRootButton"
                                                        AutomationProperties.Name="复制环境数据目录" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource App.SectionRow}">
                                            <Grid MinWidth="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="142" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="默认工作目录"
                                                           Style="{StaticResource App.Text.BodyStrong}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SelectedProfile.WorkingDirectory, TargetNullValue=未设置, FallbackValue=未设置}"
                                                           ToolTip="{Binding SelectedProfile.WorkingDirectory}"
                                                           Style="{StaticResource App.Text.Path}"
                                                           Margin="0,0,12,0"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Command="{Binding OpenWorkingDirectoryCommand}"
                                                        Content="打开"
                                                        Style="{StaticResource App.TertiaryButton}"
                                                        AutomationProperties.AutomationId="OpenWorkingDirectoryButton"
                                                        AutomationProperties.Name="打开默认工作目录" />
                                            </Grid>
                                        </Border>
                                        <Border Padding="0,14,0,0" MinHeight="72">
                                            <Grid MinWidth="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="142" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Codex 应用"
                                                           Style="{StaticResource App.Text.BodyStrong}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CodexDetectionText}"
                                                                   Style="{StaticResource App.Text.Body}" />
                                                        <TextBlock Text="{Binding CodexVersionText}"
                                                                   Style="{StaticResource App.Text.Caption}"
                                                                   Margin="8,1,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CodexExecutablePath}"
                                                               ToolTip="{Binding CodexExecutablePath}"
                                                               Style="{StaticResource App.Text.Path}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Command="{Binding RefreshCodexCommand}"
                                                        Content="重新检测"
                                                        Style="{StaticResource App.TertiaryButton}"
                                                        AutomationProperties.AutomationId="RefreshCodexInSettingsButton"
                                                        AutomationProperties.Name="重新检测 Codex 应用" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Advanced -->
                                    <StackPanel AutomationProperties.AutomationId="AdvancedTabPanel">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdvancedTab}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="高级"
                                                   Style="{StaticResource App.Text.SectionTitle}"
                                                   Margin="0,0,0,12" />
                                        <Expander Header="运行详情"
                                                  Style="{StaticResource App.Expander}"
                                                  IsExpanded="True"
                                                  AutomationProperties.AutomationId="TechnicalDetailsExpander"
                                                  AutomationProperties.Name="展开运行详情">
                                            <StackPanel Margin="0,16,0,2">
                                                <TextBlock Text="{Binding RuntimeDetails}"
                                                           Style="{StaticResource App.Text.Body}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,14" />
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="142" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="最近启动" Style="{StaticResource App.Text.Caption}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SelectedProfile.LastStartedDisplay}"
                                                               Style="{StaticResource App.Text.Caption}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="142" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Codex 数据" Style="{StaticResource App.Text.Caption}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SelectedProfile.CodexHomePath}"
                                                               ToolTip="{Binding SelectedProfile.CodexHomePath}"
                                                               Style="{StaticResource App.Text.Technical}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="142" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="应用数据" Style="{StaticResource App.Text.Caption}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SelectedProfile.AppDataPath}"
                                                               ToolTip="{Binding SelectedProfile.AppDataPath}"
                                                               Style="{StaticResource App.Text.Technical}" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="142" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="配置文件" Style="{StaticResource App.Text.Caption}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SelectedProfile.ConfigPath}"
                                                               ToolTip="{Binding SelectedProfile.ConfigPath}"
                                                               Style="{StaticResource App.Text.Technical}" />
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="高级配置（TOML）"
                                                  Style="{StaticResource App.Expander}"
                                                  Margin="0,12,0,0"
                                                  IsExpanded="True"
                                                  AutomationProperties.AutomationId="ConfigEditorExpander"
                                                  AutomationProperties.Name="展开 Codex 配置编辑器">
                                            <Grid Margin="0,16,0,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Grid.Row="0"
                                                         Text="{Binding ConfigText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource App.EditorTextBox}"
                                                         AcceptsReturn="True"
                                                         AcceptsTab="True"
                                                         TextWrapping="NoWrap"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         VerticalScrollBarVisibility="Auto"
                                                         SpellCheck.IsEnabled="False"
                                                         AutomationProperties.AutomationId="ConfigEditorTextBox"
                                                         AutomationProperties.Name="Codex 配置文本" />
                                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="有未保存的更改"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource App.Text.Caption}">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}" />
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConfigDirty}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding SaveConfigCommand}"
                                                            IsEnabled="{Binding IsConfigDirty}"
                                                            Content="保存配置"
                                                            Style="{StaticResource App.PrimaryButton}"
                                                            MinWidth="116"
                                                            AutomationProperties.AutomationId="SaveConfigButton"
                                                            AutomationProperties.Name="保存 Codex 配置" />
                                                </Grid>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>

                                    <!-- Manage -->
                                    <StackPanel AutomationProperties.AutomationId="ManageTabPanel">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsManageTab}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="环境管理"
                                                   Style="{StaticResource App.Text.SectionTitle}"
                                                   Foreground="{DynamicResource App.Brush.TextPrimary}"
                                                   FontSize="14"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="复制会生成新环境。删除会永久移除启动器记录及对应数据目录。修改数据目录请用「编辑环境」并确认迁移。"
                                                   Style="{StaticResource App.Text.Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,16" />

                                        <Border Style="{StaticResource App.Card}" Padding="16" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="环境名称"
                                                           Style="{StaticResource App.Text.Caption}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SelectedProfile.Name}"
                                                           Style="{StaticResource App.Text.BodyStrong}" />
                                                <TextBlock Grid.Row="1"
                                                           Text="数据目录"
                                                           Style="{StaticResource App.Text.Caption}"
                                                           Margin="0,10,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="{Binding SelectedProfile.DataRoot}"
                                                           Style="{StaticResource App.Text.Path}"
                                                           Margin="0,10,0,0"
                                                           ToolTip="{Binding SelectedProfile.DataRoot}" />
                                                <TextBlock Grid.Row="2"
                                                           Text="工作目录"
                                                           Style="{StaticResource App.Text.Caption}"
                                                           Margin="0,10,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="1"
                                                           Text="{Binding SelectedProfile.WorkingDirectory, TargetNullValue=未设置, FallbackValue=未设置}"
                                                           Style="{StaticResource App.Text.Path}"
                                                           Margin="0,10,0,0" />
                                            </Grid>
                                        </Border>

                                        <WrapPanel>
                                            <Button Command="{Binding EditProfileCommand}"
                                                    Content="编辑 / 迁移数据目录"
                                                    Style="{StaticResource App.PrimaryButton}"
                                                    MinWidth="160"
                                                    AutomationProperties.AutomationId="ManageEditProfileButton"
                                                    AutomationProperties.Name="编辑环境或迁移数据目录" />
                                            <Button Command="{Binding DuplicateProfileCommand}"
                                                    Content="复制环境"
                                                    Style="{StaticResource App.SecondaryButton}"
                                                    Margin="10,0,0,0"
                                                    MinWidth="110"
                                                    AutomationProperties.AutomationId="DuplicateProfileButton"
                                                    AutomationProperties.Name="复制当前环境" />
                                            <Button Command="{Binding DeleteProfileCommand}"
                                                    Content="删除环境及数据"
                                                    Style="{StaticResource App.DangerButton}"
                                                    Margin="10,0,0,0"
                                                    MinWidth="128"
                                                    AutomationProperties.AutomationId="DeleteProfileButton"
                                                    AutomationProperties.Name="删除当前环境及数据" />
                                            <Button Command="{Binding OpenDataRootCommand}"
                                                    Content="打开数据目录"
                                                    Style="{StaticResource App.TertiaryButton}"
                                                    Margin="10,0,0,0"
                                                    MinWidth="110"
                                                    AutomationProperties.AutomationId="ManageOpenDataRootButton"
                                                    AutomationProperties.Name="打开环境数据目录" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
