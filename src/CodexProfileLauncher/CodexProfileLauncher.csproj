<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodexProfileLauncher.Core\CodexProfileLauncher.Core.csproj" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <!-- Ship the built-in skill library next to the app for per-profile install. -->
  <ItemGroup>
    <Content Include="..\..\skills\builtin\**\*"
             Link="skills\builtin\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AssemblyName>CodexProfileLauncher</AssemblyName>
    <AssemblyTitle>Codex 环境启动器</AssemblyTitle>
    <Product>Codex 环境启动器</Product>
    <Description>为 Windows Codex 应用创建、验证并启动相互隔离的数据环境。</Description>
    <Company>Codex Profile Launcher Contributors</Company>
    <Copyright>Copyright © 2026 Codex Profile Launcher Contributors</Copyright>
    <Version>1.1.6</Version>
    <AssemblyVersion>1.1.6.0</AssemblyVersion>
    <FileVersion>1.1.6.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <NoWarn>$(NoWarn);WPF0001;CA1822</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
