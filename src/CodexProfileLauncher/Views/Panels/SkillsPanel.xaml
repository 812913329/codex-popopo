<UserControl x:Class="CodexProfileLauncher.Views.Panels.SkillsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="420"
             AutomationProperties.AutomationId="SkillsPanel"
             AutomationProperties.Name="技能配置面板">
    <!--
      外层主窗已有 ScrollViewer 时，子级 * 高度会测成无限，ListBox 会撑开而不出滚动条。
      因此列表使用固定 MaxHeight + 显式 VerticalScrollBarVisibility=Auto。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="技能库"
                           Style="{StaticResource App.Text.SectionTitle}"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           FontSize="14" />
                <TextBlock Text="{Binding SkillsSummary}"
                           Style="{StaticResource App.Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Content="安装全部内置"
                        Command="{Binding InstallAllSkillsCommand}"
                        Style="{StaticResource App.SecondaryButton}"
                        MinWidth="118"
                        AutomationProperties.AutomationId="InstallAllSkillsButton" />
                <Button Content="导入…"
                        Command="{Binding ImportSkillCommand}"
                        Style="{StaticResource App.SecondaryButton}"
                        Margin="8,0,0,0"
                        MinWidth="80"
                        AutomationProperties.AutomationId="ImportSkillButton" />
                <Button Content="打开目录"
                        Command="{Binding OpenSkillsDirectoryCommand}"
                        Style="{StaticResource App.TertiaryButton}"
                        Margin="8,0,0,0"
                        MinWidth="80"
                        AutomationProperties.AutomationId="OpenSkillsDirectoryButton" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1" MinHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource App.Card}"
                    Padding="0"
                    MinHeight="360">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding SkillSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource App.TextBox}"
                             Margin="12,12,12,8"
                             MinHeight="36"
                             AutomationProperties.AutomationId="SkillSearchTextBox"
                             AutomationProperties.Name="搜索技能" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredSkills}"
                             SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="4,0,4,8"
                             MinHeight="280"
                             MaxHeight="480"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.AutomationId="SkillList"
                             AutomationProperties.Name="技能列表">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,8,8,8" MinWidth="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0" MinWidth="0">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource App.Text.BodyStrong}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource App.Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="启用后写入本环境 CODEX_HOME/skills"
                                              AutomationProperties.Name="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource App.Card}"
                    Padding="16"
                    MinHeight="360">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding SelectedSkill.Name, TargetNullValue=选择技能, FallbackValue=选择技能}"
                                   Style="{StaticResource App.Text.BodyStrong}" />
                        <TextBlock Text="{Binding SelectedSkill.Description, TargetNullValue='', FallbackValue=''}"
                                   Style="{StaticResource App.Text.Caption}"
                                   TextWrapping="Wrap"
                                   MaxHeight="72"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,12,0,10">
                        <Button Content="保存 SKILL.md"
                                Command="{Binding SaveSelectedSkillCommand}"
                                Style="{StaticResource App.PrimaryButton}"
                                MinWidth="120"
                                AutomationProperties.AutomationId="SaveSkillMarkdownButton" />
                        <Button Content="重置为内置"
                                Command="{Binding ResetSelectedSkillCommand}"
                                Style="{StaticResource App.SecondaryButton}"
                                Margin="8,0,0,0"
                                MinWidth="110"
                                AutomationProperties.AutomationId="ResetSkillButton" />
                    </WrapPanel>

                    <TextBox Grid.Row="2"
                             Text="{Binding SelectedSkillMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource App.EditorTextBox}"
                             MinHeight="220"
                             MaxHeight="420"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource App.Font.Mono}"
                             IsEnabled="{Binding HasSelectedSkill}"
                             SpellCheck.IsEnabled="False"
                             AutomationProperties.AutomationId="SkillMarkdownEditor"
                             AutomationProperties.Name="技能 SKILL.md 编辑器" />

                    <TextBlock Grid.Row="3"
                               Text="{Binding SkillEditorHint}"
                               Style="{StaticResource App.Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
