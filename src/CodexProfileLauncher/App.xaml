<Application x:Class="CodexProfileLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- App mark: quiet teal monogram, no gradient shell -->
            <DrawingImage x:Key="App.VectorIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#E6F4F2" Geometry="M 0,0 L 16,0 16,16 0,16 Z" />
                        <GeometryDrawing Geometry="M 4,4 L 4,12 M 8,3 L 8,13 M 12,5 L 12,11">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#0F766E"
                                     Thickness="1.6"
                                     StartLineCap="Round"
                                     EndLineCap="Round" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#0F766E">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="12.5,4" RadiusX="1.2" RadiusY="1.2" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
        </ResourceDictionary>
    </Application.Resources>
</Application>
